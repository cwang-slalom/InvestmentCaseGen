# Phase 1 FastAPI and Vite development.
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:8000"
UVICORN_HOST="0.0.0.0"
UVICORN_PORT="8000"

# AI provider mode for the Phase 1 generation boundary.
# Use "deterministic" for local no-network mock generation.
# Use "databricks" only after the client approves the backend resource type.
MODEL_PROVIDER_MODE="deterministic"

# Databricks live AI configuration. Do not commit real token values.
# DATABRICKS_HOST="https://your-workspace.cloud.databricks.com"
# DATABRICKS_MODEL_SERVING_ENDPOINT="<approved-endpoint-or-agent-resource>"
# Optional local-only token. Databricks Apps should use app identity where approved.
# DATABRICKS_TOKEN="dapi-or-oauth-token"

# Future persistence configuration. Do not enable for Phase 1 unless approved.
# DATABASE_URL="postgresql+psycopg://..."
